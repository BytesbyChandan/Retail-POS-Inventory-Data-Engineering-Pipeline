
-- Fact Tables
create or replace table fct_daily_sales
(
    report_date DATE,
    store_id VARCHAR(50),
    category VARCHAR(50),
    store_name VARCHAR(50),
    total_revenue FLOAT,
    total_units INT,
    total_txns INT,
    avg_basket FLOAT,
    unique_customers INT
);

insert into fct_daily_sales
select 
    transaction_date AS report_date,
    store_id,
    category,
    store_name,
    SUM(total_amount) AS total_revenue,
    SUM(quantity) AS total_units,
    COUNT(DISTINCT transaction_id) AS total_txns,
    SUM(total_amount) / NULLIF(COUNT(DISTINCT transaction_id), 0) AS avg_basket,
    COUNT(DISTINCT customer_id) AS unique_customers
from silver_csv
group by
    transaction_date,
    store_id,
    category,
    store_name;

select * from fct_daily_sales;

create or replace table fct_gross_margin
(
    store_id VARCHAR(50),
    category VARCHAR(50),
    store_name VARCHAR(50),
    total_revenue FLOAT,
    total_cost FLOAT,
    gross_profit FLOAT,
    gross_margin_pct FLOAT,
    total_units_sold INT,
    total_orders INT
);


insert into fct_gross_margin
select 
    store_id,
    category,
    store_name,

    SUM(total_amount) AS total_revenue,

    SUM(quantity * unit_price) AS total_cost,

    SUM(total_amount) - SUM(quantity * unit_price)
        AS gross_profit,

    (
        (SUM(total_amount) - SUM(quantity * unit_price))
        / NULLIF(SUM(total_amount), 0)
    ) * 100 AS gross_margin_pct,

    SUM(quantity) AS total_units_sold,

    COUNT(DISTINCT transaction_id) AS total_orders

FROM silver_csv
GROUP BY
    store_id,
    category,
    store_name;

select * from fct_gross_margin;


CREATE OR REPLACE TABLE fct_category_sales
(
    report_date DATE,
    store_id VARCHAR(50),
    category VARCHAR(50),
    total_revenue FLOAT,
    total_units INT,
    total_transactions INT,
    unique_customers INT,
    avg_unit_price FLOAT
);

insert into fct_category_sales
select
    transaction_date,
    store_id,
    category,
    SUM(total_amount),
    SUM(quantity),
    COUNT(DISTINCT transaction_id),
    COUNT(DISTINCT customer_id),
    AVG(unit_price)
from silver_csv
group by
    transaction_date,
    store_id,
    category;

select * from fct_category_sales;
